PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/jan-suvidha
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional SMS delivery. Without these, development OTPs are logged and
# returned in the API response; configure Twilio for real SMS delivery.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional - only needed if you enable file uploads via Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
